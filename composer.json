{
    "name": "jaypee-solutions/jp-permissions",
    "description": "JP Permissions for WordPress is a WordPress plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Jan-Peter Alten",
            "email": "support@jaypee.solutions"
        }
    ],
    "require": {
        "php": ">=8.0",
        "yahnis-elsts/plugin-update-checker": "^5.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^1.1",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.4",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2"
    },
    "config": {
        "platform": {
            "php": "8.0.30"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs && scripts/check-test-seams.sh",
        "lint:fix": "phpcbf",
        "test": "phpunit",
        "build": "scripts/build-release.sh"
    }
}
