{
  "name": "jp-permissions",
  "version": "0.1.0",
  "description": "JP Permissions for WordPress is a WordPress plugin.",
  "license": "GPL-2.0-or-later",
  "author": "Jan-Peter Alten <support@jaypee.solutions>",
  "private": true,
  "scripts": {
    "env:start": "scripts/wp-env-ensure.sh start",
    "env:stop": "scripts/wp-env-ensure.sh stop",
    "env:seed": "scripts/wp-env-ensure.sh seed",
    "test:e2e:run": "scripts/run-e2e.sh",
    "test:e2e:dev": "scripts/run-e2e.sh",
    "test:e2e:dev:grep": "scripts/run-e2e.sh --grep",
    "test:integration": "scripts/run-integration.sh",
    "test:e2e": "scripts/run-e2e.sh --no-seed --no-opcache",
    "test:e2e:ui": "scripts/run-e2e.sh --no-seed --no-opcache -- --ui",
    "test:install": "npx --no-install playwright install --with-deps chromium",
    "test:unit": "composer test",
    "test:unit:coverage": "vendor/bin/phpunit --coverage-text",
    "build:release": "scripts/build-release.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@wordpress/env": "^12.0.0",
    "husky": "^9.1.7"
  }
}
